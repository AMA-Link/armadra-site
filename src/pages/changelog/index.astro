---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/home/TopNav.astro';
import Footer from '../../components/common/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import T from '../../components/common/T.astro';
import Icon from '../../components/common/Icon.astro';
import { CHANGELOG } from '../../data/changelog';
import { REPO_URL } from '../../lib/nav';
import { S } from '../../i18n';

const C = S.changelog;
const anchor = (v: string) => `v${v.replace(/\./g, '-')}`;
---

<BaseLayout page="changelog" title={C.docTitle.zh} titleEn={C.docTitle.en}>
  <TopNav page="changelog" />
  <main id="main" class="container log">
    <div class="log__col">
      <PageHeader title={C.title} />

      <ol class="log__list" role="list">
        {
          CHANGELOG.map((r, i) => (
            <>
              {i > 0 && <li class="log__rule" aria-hidden="true"><hr class="hairline-x" /></li>}
              <li class="log__item" id={anchor(r.version)}>
                <p class="log__meta meta">
                  <a class="log__version link-quiet" href={`#${anchor(r.version)}`}>v{r.version}</a>
                  <time datetime={r.date}>{r.date}</time>
                  {i === 0 && <span class="badge badge--success"><T zh={C.latest.zh} en={C.latest.en} /></span>}
                </p>
                <h2 class="log__heading"><T zh={r.title.zh} en={r.title.en} /></h2>
                <ul class="log__points" role="list">
                  {r.items.map((it) => (
                    <li><T zh={it.zh} en={it.en} /></li>
                  ))}
                </ul>
                <a class="log__link link-quiet link-arrow meta" href={`${REPO_URL}/releases/tag/v${r.version}`}>
                  <T zh={C.release.zh} en={C.release.en} />
                  <Icon name="arrow-up-right" size={12} />
                </a>
              </li>
            </>
          ))
        }
      </ol>

      <p class="log__more meta">
        <a class="link-quiet link-arrow" href={`${REPO_URL}/blob/main/CHANGELOG.md`}>
          <T zh={C.full.zh} en={C.full.en} />
          <Icon name="arrow-up-right" size={12} />
        </a>
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .log__col { max-width: var(--prose-max); margin-inline: auto; }
  .log__list { margin: 0; padding: 0; }
  .log__item { padding-block: var(--space-loose); scroll-margin-top: calc(var(--nav-h) + var(--space-section)); }
  .log__rule { margin: 0; }
  .log__rule hr { margin: 0; }
  .log__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-inset);
  }
  .log__version { color: var(--text); }
  .log__heading {
    margin-top: var(--space-block);
    font: 600 var(--text-display) / var(--lh-display) var(--font-ui);
    letter-spacing: -0.01em;
  }
  .log__points {
    display: flex;
    flex-direction: column;
    gap: var(--space-group);
    margin: var(--space-block) 0 0;
    padding: 0;
    font: 400 var(--text-body) / var(--lh-lede) var(--font-ui);
    color: var(--muted-foreground);
  }
  .log__points li {
    position: relative;
    padding-left: var(--space-block);
  }
  .log__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: var(--r-pill);
    background: var(--faint);
  }
  .log__link { margin-top: var(--space-block); }
  .log__more { margin-top: var(--space-block); }
</style>
