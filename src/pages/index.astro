---
/**
 * 首页：单列 1088，分区之间是两端渐隐的发丝线。顺序：首屏、软件画面、协作示例、
 * 核心能力、支持的工具、部署与数据、常见问题、开始使用与联系。设计见 DESIGN.md「首页」。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/home/TopNav.astro';
import Hero from '../components/home/Hero.astro';
import Entry from '../components/home/Entry.astro';
import CircleFigure from '../components/home/CircleFigure.astro';
import ToolsTable from '../components/home/ToolsTable.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/common/Footer.astro';
import SectionFrame from '../components/common/SectionFrame.astro';
import T from '../components/common/T.astro';
import Icon from '../components/common/Icon.astro';
import { H } from '../i18n/home';
import { S, fmtBi } from '../i18n';
import { RELEASE } from '../data/release';
import { RELEASES_URL } from '../lib/nav';

const version = fmtBi(H.start.text, { v: RELEASE.version });
/** 录屏资源（public/media/），换片时改这里 */
const DEMO = { webm: '/media/armadra-demo-tree.webm', poster: '/media/armadra-demo-tree.jpg', width: 1920, height: 1200 };
---

<BaseLayout page="home" title={H.docTitle.zh} titleEn={H.docTitle.en}>
  <TopNav page="home" />
  <main id="main" class="container home">
    <Hero />

    <!-- 真实软件录屏：隔离环境里真跑 Claude Code 与 Codex，录制方法见 docs/guides/recording.md -->
    <SectionFrame id="demo" labelledby="demo-label">
      <h2 id="demo-label" class="sr-only">Armadra</h2>
      <div class="demo card card--lifted" data-reveal>
        <video
          class="demo__video"
          data-demo
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          width={DEMO.width}
          height={DEMO.height}
          poster={DEMO.poster}
          aria-label={H.demo.zh}
          data-aria-zh={H.demo.zh}
          data-aria-en={H.demo.en}
        >
          <source src={DEMO.webm} type="video/webm" />
        </video>
      </div>
    </SectionFrame>

    <SectionFrame id="example" labelledby="example-title">
      <Entry
        id="example-title"
        level="h2"
        meta={H.example.meta}
        title={H.example.title}
        text={H.example.text}
        link={{ href: H.example.href, label: H.example.docs }}
      >
        <CircleFigure slot="figure" image={H.example.image} alt={H.example.alt} />
      </Entry>
    </SectionFrame>

    <SectionFrame id="features" title={H.features.title} more={{ href: '/docs/', label: H.features.all }}>
      {
        H.features.items.map((it, i) => (
          <>
            {i > 0 && <hr class="hairline-x" />}
            <Entry
              flip={i % 2 === 0}
              meta={it.meta}
              title={it.term}
              text={it.line}
              link={{ href: it.href, label: H.features.docs }}
            >
              <CircleFigure slot="figure" image={it.image} alt={it.alt} />
            </Entry>
          </>
        ))
      }
    </SectionFrame>

    <SectionFrame id="tools" title={H.tools.title} more={{ href: '/docs/agents/', label: H.tools.docs }}>
      <p class="home__lede"><T zh={H.tools.text.zh} en={H.tools.text.en} /></p>
      <ToolsTable />
      <p class="home__note meta"><T zh={H.tools.note.zh} en={H.tools.note.en} /></p>
    </SectionFrame>

    <SectionFrame id="deploy" labelledby="deploy-title">
      <Entry
        id="deploy-title"
        flip
        meta={H.deploy.meta}
        title={H.deploy.title}
        link={{ href: H.deploy.href, label: H.deploy.more }}
      >
        {H.deploy.items.map((it) => <p class="entry__para"><T zh={it.zh} en={it.en} /></p>)}
        <CircleFigure slot="figure" image={H.deploy.image} alt={H.deploy.alt} />
      </Entry>
    </SectionFrame>

    <SectionFrame id="faq" title={H.faq.title}>
      <Faq items={H.faq.items} />
    </SectionFrame>

    <SectionFrame id="start" labelledby="start-title">
      <div class="start">
        <h2 id="start-title" class="start__title"><T zh={H.start.title.zh} en={H.start.title.en} /></h2>
        <p class="home__lede"><T zh={version.zh} en={version.en} /></p>
        <div class="start__actions">
          <a class="btn-primary btn--lg" href={RELEASES_URL}><Icon name="download" size={14} /><T zh={H.hero.download.zh} en={H.hero.download.en} /></a>
          <a class="btn-ghost btn--lg" href="/docs/quickstart/"><T zh={H.hero.quickstart.zh} en={H.hero.quickstart.en} /><Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </SectionFrame>

    <SectionFrame id="contact" title={S.contact.title}>
      <ul class="contact" role="list">
        {
          S.contact.items.map((c) => (
            <li class="contact__item meta">
              <T zh={c.label.zh} en={c.label.en} />
              <a class="link-quiet" href={`mailto:${c.email}`}>{c.email}</a>
            </li>
          ))
        }
      </ul>
    </SectionFrame>
  </main>
  <Footer />
</BaseLayout>

<script>
  // 偏好减少动效时不自动播放，停在 poster 上；点一下仍可播放
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('[data-demo]').forEach((video) => {
    const apply = () => {
      if (reduce.matches) {
        video.pause();
        video.controls = true;
      } else {
        video.controls = false;
        void video.play().catch(() => {});
      }
    };
    apply();
    reduce.addEventListener('change', apply);
  });
</script>

<style>
  .home { padding-bottom: 0; }
  .home__lede {
    max-width: 62ch;
    margin-bottom: var(--space-section);
    font: 400 var(--text-lede) / var(--lh-lede) var(--font-ui);
    color: var(--muted-foreground);
  }
  .home__note { margin-top: var(--space-block); font-size: var(--text-meta); line-height: var(--lh-meta); }

  /* 录屏：整列宽的卡片，不加说明 */
  .demo { overflow: hidden; }
  .demo__video { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; background: var(--panel); }

  .start { max-width: 62ch; }
  .start__title {
    margin-bottom: var(--space-block);
    font: 600 var(--text-hero) / var(--lh-hero) var(--font-ui);
    letter-spacing: -0.02em;
  }
  .start__actions { display: flex; flex-wrap: wrap; gap: var(--space-inset); }

  .contact { display: flex; flex-wrap: wrap; gap: var(--space-group) var(--space-section); margin: 0; padding: 0; }
  .contact__item { display: inline-flex; flex-wrap: wrap; gap: var(--space-group); }

  @media (max-width: 640px) {
    .start__actions { flex-direction: column; }
    .start__actions > * { width: 100%; }
  }
</style>
