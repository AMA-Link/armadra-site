---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/home/TopNav.astro';
import Footer from '../components/common/Footer.astro';
import T from '../components/common/T.astro';
import Icon from '../components/common/Icon.astro';
import AppModel from '../components/model/AppModel.astro';
import { H } from '../i18n/home';
import { M } from '../i18n/model';
import { AGENTS } from '../data/agents';
import { RELEASE } from '../data/release';
import { RELEASES_URL } from '../lib/nav';

const steps = H.story.steps;
const pad = (n: number) => String(n).padStart(2, '0');
const storyData = JSON.stringify(steps.map((s) => ({ areas: s.areas })));
---

<BaseLayout page="home" title={H.docTitle.zh} titleEn={H.docTitle.en}>
  <TopNav page="home" />
  <main id="main" class="home">
    <!-- 首屏：只有标题与两个按钮，下方一条线引向软件 -->
    <section class="hero container" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero__title">
        {H.hero.title.map((l, i) => <span class="hero__line" style={`--reveal-delay:${i * 120}ms`} data-reveal><T zh={l.zh} en={l.en} /></span>)}
      </h1>
      <div class="hero__actions" data-reveal style="--reveal-delay:260ms">
        <a class="btn-primary" href={RELEASES_URL}><Icon name="download" size={14} /><T zh={H.hero.download.zh} en={H.hero.download.en} /></a>
        <a class="btn-ghost" href="/docs/quickstart/"><T zh={H.hero.docs.zh} en={H.hero.docs.en} /></a>
      </div>
      <span class="hero__cue" aria-hidden="true"></span>
    </section>

    <!-- 滚动叙事：模型 sticky，往下滚逐步高亮 -->
    <section
      class="story"
      aria-labelledby="story-title"
      data-story
      data-steps={storyData}
      data-hotspot-label={M.hotspot.zh}
      style={`--steps:${steps.length}`}
    >
      <div class="story__sticky">
        <div class="story__inner container">
          <div class="story__bar">
            <p class="corner story__label" id="story-title"><T zh={H.story.label.zh} en={H.story.label.en} /></p>
            <ol class="story__segs" role="list">
              {
                steps.map((s, i) => (
                  <li>
                    <button type="button" class="story__seg" data-story-title aria-label={`${pad(i + 1)} ${s.title.zh}`} data-aria-zh={`${pad(i + 1)} ${s.title.zh}`} data-aria-en={`${pad(i + 1)} ${s.title.en}`}>
                      <span class="story__n">{pad(i + 1)}</span>
                      <span class="story__fill" />
                    </button>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="story__model">
            <AppModel />
          </div>
          <div class="story__captions" aria-live="polite">
            {
              steps.map((s, i) => (
                <p class="story__caption" data-story-caption hidden={i !== 0}>
                  <span class="story__caption-n">{pad(i + 1)}</span>
                  <T zh={s.title.zh} en={s.title.en} />
                </p>
              ))
            }
          </div>
        </div>
      </div>
      <div class="story__steps" data-story-track aria-hidden="true">
        {steps.map(() => <div class="story__step" data-story-step />)}
      </div>
    </section>

    <!-- 支持的 Agent：大字一行一个 -->
    <section class="agents container" aria-labelledby="agents-title">
      <h2 id="agents-title" class="section-title" data-reveal><T zh={H.agents.title.zh} en={H.agents.title.en} /></h2>
      <ul class="agents__list" role="list">
        {
          AGENTS.map((a, i) => (
            <li class="agents__row" data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <span class="agents__n">{pad(i + 1)}</span>
              <span class="agents__name">{a.name}</span>
              {a.name === 'ama' && (
                <span class="agents__tag">
                  <T zh={H.agents.coordinator.zh} en={H.agents.coordinator.en} />
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 收尾 -->
    <section class="cta container" aria-labelledby="cta-title">
      <h2 id="cta-title" class="cta__title">
        {H.cta.title.map((l, i) => <span class="hero__line" style={`--reveal-delay:${i * 120}ms`} data-reveal><T zh={l.zh} en={l.en} /></span>)}
      </h2>
      <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
        <a class="btn-primary" href={RELEASES_URL}><Icon name="download" size={14} /><T zh={H.cta.download.zh} en={H.cta.download.en} /></a>
        <a class="btn-ghost" href="/docs/quickstart/"><T zh={H.cta.quickstart.zh} en={H.cta.quickstart.en} /></a>
        <a class="btn-ghost" href="/changelog/"><T zh={H.cta.changelog.zh} en={H.cta.changelog.en} /><span class="mono">v{RELEASE.version}</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initStory } from '../scripts/model/story';
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((s) => initStory(s));
</script>

<style>
  /* 全页两条纵向导轨线，贯穿各段 */
  .home { position: relative; }
  .home::before,
  .home::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
    pointer-events: none;
  }
  .home::before { left: max(calc(var(--gutter) / 2), calc((100% - var(--content-max)) / 2)); }
  .home::after { right: max(calc(var(--gutter) / 2), calc((100% - var(--content-max)) / 2)); }

  /* 首屏 */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--nav-h));
    padding-block: var(--sp-9) var(--sp-10);
  }
  .hero__title,
  .cta__title {
    font: 500 var(--fs-hero) / 1.02 var(--font-sans);
    letter-spacing: -0.04em;
  }
  .hero__line { display: block; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }
  .hero__actions .mono { color: var(--ink-3); font-size: var(--fs-mono); }
  .hero__cue {
    position: absolute;
    left: max(var(--gutter), calc((100% - var(--content-max)) / 2 + var(--gutter)));
    bottom: 0;
    width: 1px;
    height: var(--sp-10);
    background: var(--ink);
    transform-origin: top;
    animation: cue 2.4s var(--ease-out) infinite;
  }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* 滚动叙事 */
  .story {
    position: relative;
    height: calc(var(--steps) * 70svh + 100svh);
    border-top: 1px solid var(--line-strong);
  }
  .story__sticky {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow: hidden;
  }
  .story__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-5);
    height: 100%;
  }
  .story__bar {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: var(--sp-6);
  }
  .story__segs {
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
  }
  .story__seg {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    width: 100%;
    min-height: var(--control-h);
    justify-content: flex-end;
    text-align: left;
  }
  .story__n {
    font: 400 var(--fs-mono-sm) / 1 var(--font-mono);
    color: var(--ink-3);
    transition: color var(--dur-2) var(--ease-out);
  }
  .story__fill {
    position: relative;
    display: block;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .story__fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(var(--seg, 0));
    transform-origin: left;
  }
  .story__seg:hover .story__n,
  .story__seg[data-active] .story__n { color: var(--accent-text); }
  .story__seg[data-active] .story__fill::after { background: var(--accent-ui); }
  .story__model {
    width: 100%;
    max-width: calc((100svh - var(--nav-h) - 220px) * 1200 / 760);
    margin-inline: auto;
  }
  .story__captions { min-height: calc(var(--fs-h1) * 1.3); }
  .story__caption {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    font: 500 var(--fs-h1) / 1.2 var(--font-sans);
    letter-spacing: -0.025em;
    animation: cap-in 500ms var(--ease-out);
  }
  .story__caption-n { font: 400 var(--fs-mono) / 1 var(--font-mono); color: var(--accent-text); }
  @keyframes cap-in { from { opacity: 0; transform: translateY(10px); } }

  .story__steps {
    position: absolute;
    left: 0;
    right: 0;
    top: 50svh;
    bottom: 50svh;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .story__step { flex: 1; }

  /* 分区标题 */
  .section-title {
    font: 500 var(--fs-display) / 1.05 var(--font-sans);
    letter-spacing: -0.03em;
    padding-block: var(--sp-9) var(--sp-7);
  }

  /* 支持的 Agent */
  .agents { border-top: 1px solid var(--line-strong); }
  .agents__list { margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .agents__row {
    display: grid;
    grid-template-columns: 4ch auto 1fr;
    align-items: baseline;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--line-strong);
  }
  .agents__n { font: 400 var(--fs-mono) / 1 var(--font-mono); color: var(--ink-3); }
  .agents__name { font: 500 var(--fs-agent) / 1.1 var(--font-sans); letter-spacing: -0.03em; }
  .agents__tag { justify-self: end; color: var(--accent-text); font: 500 var(--fs-body) / 1 var(--font-sans); }

  /* 收尾 */
  .cta { padding-block: var(--sp-10); }

  @media (max-width: 900px) {
    .story { height: calc(var(--steps) * 80svh + 100svh); }
    .story__bar { grid-template-columns: minmax(0, 1fr); gap: var(--sp-3); }
    .story__label { display: none; }
    .story__caption { font-size: var(--fs-h2); }
  }
  @media (max-width: 640px) {
    .hero { padding-block: var(--sp-8) var(--sp-9); }
    .agents__row { gap: var(--sp-3); padding-block: var(--sp-4); }
    .agents__tag { font-size: var(--fs-body-sm); }
    .section-title { padding-block: var(--sp-8) var(--sp-6); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue { animation: none; transform: none; }
    .story__caption { animation: none; }
  }
</style>
