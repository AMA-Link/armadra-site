---
/**
 * 页面标题区：「标题 + 一句简介 + 可选操作」。标题用 --text-hero，简介用 --text-lede。
 * 用于文档索引、404 与更新日志；可选 meta 插槽放在标题上方（等宽元信息），操作放默认插槽。
 */
import type { Bi } from '../../lib/types';
import T from '../common/T.astro';

interface Props {
  title: Bi;
  intro?: Bi;
}
const { title, intro } = Astro.props;
const hasActions = Astro.slots.has('default');
const hasMeta = Astro.slots.has('meta');
---

<header class="phead">
  {hasMeta && <p class="phead__meta meta"><slot name="meta" /></p>}
  <h1 class="phead__title"><T zh={title.zh} en={title.en} /></h1>
  {intro && <p class="phead__intro"><T zh={intro.zh} en={intro.en} /></p>}
  {hasActions && <div class="phead__actions"><slot /></div>}
</header>

<style>
  .phead {
    padding-block: var(--space-band) var(--space-loose);
  }
  .phead__meta { margin-bottom: var(--space-section); }
  .phead__title {
    margin: 0;
    font: 600 var(--text-hero) / var(--lh-hero) var(--font-ui);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .phead__intro {
    max-width: 62ch;
    margin: var(--space-block) 0 0;
    font: 400 var(--text-lede) / var(--lh-lede) var(--font-ui);
    color: var(--muted-foreground);
  }
  .phead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-inset);
    margin-top: var(--space-loose);
  }
  @media (max-width: 640px) {
    .phead { padding-block: var(--space-wide) var(--space-section); }
    .phead__actions { flex-direction: column; align-items: stretch; }
  }
</style>
