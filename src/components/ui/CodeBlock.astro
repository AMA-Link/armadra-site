---
/**
 * 可复制的代码卡。code 为字符串，或 { official, cn } 两份（按 html[data-region] 只显示一份）。
 * 复制按钮在卡片右上，点击后「复制」原地替换为「已复制」（交叉淡化，宽度不变）。
 */
import type { Bi } from '../../lib/types';
import T from '../common/T.astro';
import Icon from '../common/Icon.astro';
import { S } from '../../i18n';

type Region = 'official' | 'cn';
interface Props {
  code: string | Record<Region, string>;
  label?: Bi | string;
}
const { code, label } = Astro.props;
const variants: [Region | null, string][] =
  typeof code === 'string' ? [[null, code]] : [['official', code.official], ['cn', code.cn]];
---

<div class="code" data-code>
  {label && (
    <span class="code__label meta">{typeof label === 'string' ? label : <T zh={label.zh} en={label.en} />}</span>
  )}
  {
    variants.map(([region, text]) => (
      <pre class="code__pre" data-region-only={region ?? undefined}><code>{text}</code></pre>
    ))
  }
  <button
    class="code__copy"
    type="button"
    data-copy
    aria-label={S.copy.aria.zh}
    data-aria-zh={S.copy.aria.zh}
    data-aria-en={S.copy.aria.en}
  >
    <span class="code__swap">
      <span class="code__idle"><Icon name="copy" size={12} /><T {...S.copy.idle} /></span>
      <span class="code__done"><Icon name="check" size={12} /><T {...S.copy.done} /></span>
    </span>
  </button>
</div>

<script>
  import { initCopy } from '../../scripts/copy';
  initCopy();
</script>

<style>
  .code {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-width: 0; /* 作为网格或弹性子项时不被长命令撑宽，命令在块内横向滚动 */
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
  }
  .code__label {
    position: absolute;
    top: var(--space-item);
    left: var(--space-inset);
    font-size: var(--text-meta);
    line-height: var(--lh-meta);
  }
  .code__pre {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: var(--space-inset) var(--space-block);
    overflow-x: auto;
    font: 400 var(--text-code) / var(--lh-code) var(--font-code);
    color: var(--code-plain);
    white-space: pre;
    tab-size: 2;
  }
  .code__pre code { font: inherit; color: inherit; background: none; padding: 0; }

  .code__copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--icon-btn);
    margin: var(--space-item);
    padding-inline: var(--space-group);
    border-radius: var(--r-control);
    font: 400 var(--text-meta) / var(--lh-meta) var(--font-code);
    color: var(--muted-foreground);
    transition: color var(--dur-fast) var(--ease-color), background-color var(--dur-fast) var(--ease-color),
      scale var(--dur-instant) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .code__copy:hover { color: var(--text); background: var(--hover); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .code__copy:hover:active { scale: var(--press-scale); }
  }

  /* 文字替换：两层叠放，宽度取较宽者，不跳动 */
  .code__swap { display: inline-grid; }
  .code__idle,
  .code__done {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-item);
    transition: opacity var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }
  .code__done { opacity: 0; filter: blur(2px); }
  .code__copy.is-copied { color: var(--success-text); }
  .code__copy.is-copied .code__idle { opacity: 0; filter: blur(2px); }
  .code__copy.is-copied .code__done { opacity: 1; filter: none; }
  @media (prefers-reduced-motion: reduce) {
    .code__idle,
    .code__done { filter: none; transition: opacity var(--dur-fast) linear; }
    .code__done { filter: none; }
    .code__copy.is-copied .code__idle { filter: none; }
  }
</style>
