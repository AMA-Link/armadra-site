---
/**
 * 可复制的代码块。code 为字符串，或 { official, cn } 两份（按 html[data-region] 只显示一份）。
 * block：顶部标题栏（标签 + 复制按钮）常驻，命令区不与按钮重叠；
 * inline：单行命令嵌在列表行里，复制按钮只显示图标。
 */
import type { Bi } from '../../lib/types';
import T from '../common/T.astro';
import Icon from '../common/Icon.astro';
import { S } from '../../i18n';

type Region = 'official' | 'cn';
interface Props {
  code: string | Record<Region, string>;
  label?: Bi | string;
  variant?: 'block' | 'inline';
}
const { code, label, variant = 'block' } = Astro.props;
const variants: [Region | null, string][] =
  typeof code === 'string' ? [[null, code]] : [['official', code.official], ['cn', code.cn]];
---

<div class:list={['code', `code--${variant}`]} data-code>
  {
    variant === 'block' && (
      <div class="code__head">
        <span class="code__label">
          {label && (typeof label === 'string' ? label : <T zh={label.zh} en={label.en} />)}
        </span>
        <button
          class="code__copy"
          type="button"
          data-copy
          aria-label={S.copy.aria.zh}
          data-aria-zh={S.copy.aria.zh}
          data-aria-en={S.copy.aria.en}
        >
          <Icon name="copy" size={12} />
          <span class="code__copy-idle"><T {...S.copy.idle} /></span>
          <span class="code__copy-done"><T {...S.copy.done} /></span>
        </button>
      </div>
    )
  }
  {
    variants.map(([region, text]) => (
      <pre class="code__pre" data-region-only={region ?? undefined}><code>{text}</code></pre>
    ))
  }
  {
    variant === 'inline' && (
      <button
        class="code__copy"
        type="button"
        data-copy
        aria-label={S.copy.aria.zh}
        data-aria-zh={S.copy.aria.zh}
        data-aria-en={S.copy.aria.en}
      >
        <Icon name="copy" size={12} />
      </button>
    )
  }
</div>

<script>
  import { initCopy } from '../../scripts/copy';
  initCopy();
</script>

<style>
  .code {
    position: relative;
    min-width: 0; /* 作为网格或弹性子项时不被长命令撑宽，命令在块内横向滚动 */
    background: var(--code-bg);
    border: 1px solid var(--line-soft);
  }
  .code__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    height: var(--sp-6);
    padding-left: var(--sp-3);
    border-bottom: 1px solid var(--line-soft);
  }
  .code__label {
    font: 500 var(--fs-mono-xs) / var(--lh-mono-xs) var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .code__pre {
    margin: 0;
    padding: var(--sp-3) var(--sp-4);
    overflow-x: auto;
    font: 400 var(--fs-code) / var(--lh-code) var(--font-mono);
    color: var(--code-plain);
    white-space: pre;
    tab-size: 2;
  }
  .code__pre code { font: inherit; color: inherit; background: none; padding: 0; }

  .code__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: var(--sp-6);
    padding: 0 var(--sp-2);
    font: 400 var(--fs-mono-sm) / var(--lh-mono-sm) var(--font-mono);
    color: var(--ink-3);
    transition: color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out), scale var(--dur-1) var(--ease-out);
  }
  .code__copy:hover { color: var(--ink); background: var(--hover-row); }
  .code__copy-done { display: none; }
  .code__copy.is-copied { color: var(--ink); }
  .code__copy.is-copied .code__copy-idle { display: none; }
  .code__copy.is-copied .code__copy-done { display: inline; }
  @media (prefers-reduced-motion: no-preference) {
    .code__copy:active { scale: 0.97; }
  }

  /* 行内：单行命令，按钮只留图标 */
  .code--inline {
    display: flex;
    align-items: center;
    min-width: 0;
    background: transparent;
    border: 0;
  }
  .code--inline .code__pre {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    padding-right: var(--sp-2);
    font: 400 var(--fs-mono) / var(--lh-mono) var(--font-mono);
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .code--inline .code__copy {
    flex: none;
    min-width: var(--control-h);
    min-height: var(--control-h);
    justify-content: center;
    margin-block: calc((var(--lh-mono) - var(--control-h)) / 2);
  }
</style>
