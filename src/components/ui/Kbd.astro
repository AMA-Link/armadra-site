---
/** 快捷键提示：20 高的等宽小方块，只作提示，不进入读屏；触屏没有键盘，不显示 */
interface Props {
  k: string;
  class?: string;
}
const { k, class: className } = Astro.props;
---

<kbd class:list={['kbd', className]} aria-hidden="true">{k}</kbd>

<style>
  .kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding-inline: var(--space-item);
    background: var(--surface-raised);
    border-radius: var(--r-tight);
    font: 500 var(--text-caption) / 1 var(--font-code);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }
  @media (pointer: coarse) {
    .kbd { display: none; }
  }
</style>
