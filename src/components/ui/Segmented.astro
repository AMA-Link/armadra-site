---
/**
 * 分段选择（单选）。当前项的底块是同一个元素，平移到被选中的选项上（--dur-base --ease-in-out）；
 * 文字颜色随选中同步。方向键切换、Home / End、roving tabindex。
 * 选择变化时在根元素上派发 segmented:change（detail.value），由页面脚本决定作用。
 */
import type { Bi } from '../../lib/types';
import T from '../common/T.astro';

interface Option {
  value: string;
  label: Bi;
  count?: number;
}
interface Props {
  name: string;
  label: Bi;
  options: Option[];
  value: string;
}
const { name, label, options, value } = Astro.props;
---

<div
  class="seg"
  role="radiogroup"
  aria-label={label.zh}
  data-aria-zh={label.zh}
  data-aria-en={label.en}
  data-segmented={name}
>
  <span class="seg__indicator" aria-hidden="true"></span>
  {
    options.map((o) => (
      <button
        type="button"
        class="seg__item"
        role="radio"
        aria-checked={o.value === value ? 'true' : 'false'}
        tabindex={o.value === value ? 0 : -1}
        data-value={o.value}
      >
        <T zh={o.label.zh} en={o.label.en} />
        {o.count != null && <span class="seg__count">{o.count}</span>}
      </button>
    ))
  }
</div>

<script>
  /** 把指示器放到选中项上：宽度直接设置，位置用 transform 平移 */
  function place(group: HTMLElement, animate: boolean) {
    const on = group.querySelector<HTMLElement>('.seg__item[aria-checked="true"]');
    const ind = group.querySelector<HTMLElement>('.seg__indicator');
    if (!on || !ind) return;
    if (!animate) ind.style.transition = 'none';
    ind.style.width = `${on.offsetWidth}px`;
    ind.style.transform = `translateX(${on.offsetLeft}px)`;
    if (!animate) {
      void ind.offsetWidth;
      ind.style.transition = '';
    }
    group.classList.add('is-ready');
  }

  function select(group: HTMLElement, btn: HTMLButtonElement, focus = false) {
    if (btn.getAttribute('aria-checked') === 'true') return;
    for (const b of group.querySelectorAll<HTMLButtonElement>('.seg__item')) {
      const on = b === btn;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    }
    place(group, true);
    if (focus) btn.focus();
    group.dispatchEvent(new CustomEvent('segmented:change', { bubbles: true, detail: { value: btn.dataset.value } }));
  }

  for (const group of document.querySelectorAll<HTMLElement>('[data-segmented]')) {
    if (group.dataset.ready) continue;
    group.dataset.ready = '1';
    place(group, false);
    // 字体加载、语言切换与窗口缩放都会改变选项宽度：直接重新定位，不做动画
    const refresh = () => place(group, false);
    new ResizeObserver(refresh).observe(group);
    document.addEventListener('armadra:lang', refresh);
    document.fonts?.ready.then(refresh);
    group.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('.seg__item');
      if (btn) select(group, btn);
    });
    group.addEventListener('keydown', (e) => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
      const items = [...group.querySelectorAll<HTMLButtonElement>('.seg__item')];
      const i = items.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      e.preventDefault();
      const next =
        e.key === 'Home' ? 0
        : e.key === 'End' ? items.length - 1
        : (i + (e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
      select(group, items[next], true);
    });
  }
</script>

<style>
  .seg {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    padding: 2px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-control);
  }
  .seg__indicator {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 0;
    border-radius: var(--r-tight);
    background: var(--surface-raised);
    opacity: 0;
    transition: transform var(--dur-base) var(--ease-in-out);
  }
  .seg.is-ready .seg__indicator { opacity: 1; }
  .seg__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-item);
    min-height: calc(var(--control-h) - 6px);
    padding: 0 var(--space-inset);
    border-radius: var(--r-tight);
    font: 500 var(--text-body) / var(--lh-body) var(--font-ui);
    color: var(--muted-foreground);
    transition: color var(--dur-base) var(--ease-in-out);
  }
  /* 没有脚本时，选中项自己带底 */
  .seg:not(.is-ready) .seg__item[aria-checked='true'] { background: var(--surface-raised); }
  .seg__item[aria-checked='true'] { color: var(--text); }
  @media (hover: hover) and (pointer: fine) {
    .seg__item:hover { color: var(--text); }
  }
  .seg__item:focus-visible { outline-offset: -2px; }
  .seg__count {
    font: 400 var(--text-meta) / var(--lh-meta) var(--font-code);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .seg__indicator { transition: none; }
  }
</style>
