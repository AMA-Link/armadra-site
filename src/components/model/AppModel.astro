---
/**
 * Armadra 软件界面模型：用 HTML / CSS 画出的应用窗口（不是截图）。
 * 固定设计尺寸 1200×760，由 scripts/model/ 按容器等比缩放；可点的小功能也在那里接线。
 */
import T from '../common/T.astro';
import MIcon from './MIcon.astro';
import { M } from '../../i18n/model';

type Bi = { zh: string; en: string };
const t = (b: Bi) => b;
const tools = M.dock.tools;
---

<div class="model" data-model role="group" aria-label={M.aria.zh} data-aria-zh={M.aria.zh} data-aria-en={M.aria.en}>
  <div class="model__stage" data-model-stage>
    <div class="win">
      <!-- 侧栏 -->
      <aside class="side" data-area="side">
        <div class="side__top">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="side__icons">
            <button type="button" class="ib" aria-label={M.side.toggle.zh} data-aria-zh={M.side.toggle.zh} data-aria-en={M.side.toggle.en}><MIcon name="panel" /></button>
            <button type="button" class="ib" aria-label={M.side.search.zh} data-aria-zh={M.side.search.zh} data-aria-en={M.side.search.en}><MIcon name="search" /></button>
            <button type="button" class="ib" aria-label={M.side.bell.zh} data-aria-zh={M.side.bell.zh} data-aria-en={M.side.bell.en}><MIcon name="bell" /></button>
          </span>
        </div>
        <p class="side__brand">Armadra</p>
        <button type="button" class="side__row"><MIcon name="edit" /><T {...t(M.side.newCanvas)} /></button>
        <div class="side__head">
          <span><T {...t(M.side.projects)} /></span>
          <button type="button" class="ib ib--sm" aria-label={M.side.addProject.zh} data-aria-zh={M.side.addProject.zh} data-aria-en={M.side.addProject.en}><MIcon name="plus" size={12} /></button>
        </div>
        {
          M.projects.map((p, pi) => (
            <div class="side__project">
              <p class="side__pname"><MIcon name="folder" size={13} />{p.name}</p>
              {p.canvases.map((c, ci) => (
                <button
                  type="button"
                  class="side__row side__canvas"
                  data-model-canvas
                  aria-pressed={pi === 0 && ci === 0 ? 'true' : 'false'}
                >
                  <MIcon name="canvas" size={13} />
                  <T {...t(c)} />
                </button>
              ))}
            </div>
          ))
        }
        <button type="button" class="side__row side__settings"><MIcon name="settings" /><T {...t(M.side.settings)} /></button>
      </aside>

      <!-- 画布 -->
      <section class="main">
        <div class="canvas" data-model-canvas-area>
          <div class="world" data-model-world>
            <svg class="edges" aria-hidden="true" data-model-edges>
              <g data-edge data-from="note" data-to="ama" data-kind="context" data-area="edges"><path /><text><tspan data-l="zh">{M.edge.context.zh}</tspan><tspan data-l="en">{M.edge.context.en}</tspan></text></g>
              <g data-edge data-from="ama" data-to="claude" data-kind="dispatch" data-area="edges-dispatch"><path /><text><tspan data-l="zh">{M.edge.dispatch.zh}</tspan><tspan data-l="en">{M.edge.dispatch.en}</tspan></text></g>
              <g data-edge data-from="ama" data-to="codex" data-kind="dispatch" data-area="edges-dispatch"><path /><text><tspan data-l="zh">{M.edge.dispatch.zh}</tspan><tspan data-l="en">{M.edge.dispatch.en}</tspan></text></g>
              <g data-edge data-from="claude" data-to="codex" data-kind="peer" data-area="edges"><path /><text><tspan data-l="zh">{M.edge.peer.zh}</tspan><tspan data-l="en">{M.edge.peer.en}</tspan></text></g>
              <g data-edge data-from="claude" data-to="diff" data-kind="context" data-area="edges"><path /><text><tspan data-l="zh">{M.edge.context.zh}</tspan><tspan data-l="en">{M.edge.context.en}</tspan></text></g>
              <g data-edge data-from="codex" data-to="browser" data-kind="context" data-area="edges"><path /><text><tspan data-l="zh">{M.edge.context.zh}</tspan><tspan data-l="en">{M.edge.context.en}</tspan></text></g>
            </svg>

            <!-- 便签 -->
            <article class="node node--note" data-node="note" data-area="node-note" style="left:28px;top:60px;width:210px">
              <header class="node__head"><span class="dot dot--note"></span><span class="node__name"><T {...t(M.node.note)} /></span></header>
              <p class="node__note"><T {...t(M.node.noteBody)} /></p>
            </article>

            <!-- 协调者 -->
            <article class="node" data-node="ama" data-area="node-ama" data-status="working" style="left:28px;top:300px;width:250px">
              <header class="node__head">
                <span class="dot dot--ama"></span>
                <span class="node__name">ama <em><T {...t(M.node.coordinator)} /></em></span>
                <span class="chip"><T {...t(M.node.lead)} /></span>
                <span class="pill" data-pill><T {...t(M.node.status.working)} /></span>
              </header>
              <div class="term">
                <p class="tl tl--cmd">canvas team claude codex</p>
                <p class="tl tl--dim"><T zh="2 名成员已就位，各带一条 worktree" en="2 members ready, each on a worktree" /></p>
                <p class="tl"><T zh="等待成员回报…" en="Waiting for members…" /></p>
                <span class="caret"></span>
              </div>
            </article>

            <!-- Claude Code -->
            <article class="node" data-node="claude" data-area="node-claude" data-status="waiting" style="left:318px;top:40px;width:290px">
              <header class="node__head">
                <span class="dot dot--claude"></span>
                <span class="node__name">Claude Code <em><T {...t(M.node.implement)} /></em></span>
                <span class="chip"><T {...t(M.node.member)} /></span>
                <span class="pill" data-pill>
                  <span data-pill-waiting><T {...t(M.node.status.waiting)} /></span>
                  <span data-pill-working hidden><T {...t(M.node.status.working)} /></span>
                </span>
                <span class="node__menu-wrap">
                  <button type="button" class="ib ib--sm" data-model-menu aria-haspopup="menu" aria-expanded="false" aria-label={M.node.more.zh} data-aria-zh={M.node.more.zh} data-aria-en={M.node.more.en}><MIcon name="more" size={12} /></button>
                  <span class="pop menu" role="menu" hidden>
                    {M.node.menu.map((m) => <button type="button" role="menuitem" class="pop__item"><T {...t(m)} /></button>)}
                  </span>
                </span>
              </header>
              <div class="ask" data-area="ask" data-model-ask>
                <span class="ask__label"><T {...t(M.ask.label)} /></span>
                <code class="ask__prompt">{M.ask.prompt}</code>
                <span class="ask__actions">
                  <button type="button" class="btn btn--ghost" data-model-deny><T {...t(M.ask.deny)} /></button>
                  <button type="button" class="btn btn--solid" data-model-allow><T {...t(M.ask.allow)} /></button>
                </span>
              </div>
              <div class="term" data-model-term>
                <p class="tl"><T zh="读取 src/auth/login.tsx" en="Read src/auth/login.tsx" /></p>
                <p class="tl"><T zh="编辑 src/auth/session.ts" en="Edit src/auth/session.ts" /></p>
                <p class="tl"><T zh="新增 tests/session.test.ts" en="Add tests/session.test.ts" /></p>
                <span class="caret"></span>
              </div>
            </article>

            <!-- Codex -->
            <article class="node" data-node="codex" data-area="node-codex" data-status="working" style="left:318px;top:400px;width:290px">
              <header class="node__head">
                <span class="dot dot--codex"></span>
                <span class="node__name">Codex <em><T {...t(M.node.review)} /></em></span>
                <span class="chip"><T {...t(M.node.member)} /></span>
                <span class="pill" data-pill><T {...t(M.node.status.working)} /></span>
              </header>
              <div class="term">
                <p class="tl tl--cmd">canvas inbox</p>
                <p class="tl"><T zh="读取 claude 的差异（经连线）" en="Read claude’s diff (via link)" /></p>
                <p class="tl tl--warn"><T zh="建议：cookie 加 sameSite" en="Suggest: add sameSite to the cookie" /></p>
                <span class="caret"></span>
              </div>
            </article>

            <!-- 差异 -->
            <article class="node node--diff" data-node="diff" data-area="node-diff" style="left:646px;top:40px;width:250px">
              <header class="node__head">
                <span class="dot dot--diff"></span>
                <span class="node__name mono">session.ts</span>
                <span class="diffstat"><b>+2</b> <i>−1</i></span>
              </header>
              <div class="diff">
                <p class="dl"><span>@@</span>createSession(user, opts)</p>
                <p class="dl dl--del"><span>−</span>const maxAge = DAY;</p>
                <p class="dl dl--add"><span>+</span>const maxAge = remember ? 30 * DAY : DAY;</p>
                <p class="dl dl--add"><span>+</span>setCookie('sid', token, &#123; maxAge &#125;);</p>
                <p class="dl"><span> </span>return token;</p>
              </div>
            </article>

            <!-- 浏览器 -->
            <article class="node node--browser" data-node="browser" data-area="node-browser" style="left:646px;top:330px;width:250px">
              <header class="node__head">
                <span class="dot dot--diff"></span>
                <span class="url mono">{M.browser.url}</span>
                <button type="button" class="ib ib--sm" data-model-reload aria-label="Reload"><MIcon name="reload" size={12} /></button>
              </header>
              <div class="page" data-model-page>
                <span class="page__logo"></span>
                <span class="page__input"></span>
                <span class="page__input"></span>
                <label class="page__check"><input type="checkbox" checked /><T {...t(M.browser.remember)} /></label>
                <span class="page__btn"><T {...t(M.browser.signIn)} /></span>
              </div>
            </article>

            <!-- 评论钉与他人光标 -->
            <button type="button" class="pin" data-area="pin" data-model-pin style="left:880px;top:24px" aria-label={M.comment.zh} data-aria-zh={M.comment.zh} data-aria-en={M.comment.en}>2</button>
            <span class="pop pin__pop" data-model-pin-pop hidden style="left:706px;top:-4px">
              <b>Noah</b> <T zh="记住我的过期时间要和产品确认" en="Confirm the expiry with product" />
            </span>
            <span class="cursor" data-area="cursor" style="left:560px;top:590px" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 1l11 6-5 1.5L6 14z" /></svg>
              <span>Noah</span>
            </span>
          </div>
        </div>

        <!-- 右侧抽屉（资源管理器 / GitHub / 资源）：抽屉打开时工具簇左移让开，与软件一致 -->
        <aside class="drawer" data-model-panel="explorer" hidden>
          <header class="drawer__head"><span><T {...t(M.cluster.explorer)} /></span><button type="button" class="ib ib--sm" data-model-close aria-label={M.cluster.close.zh} data-aria-zh={M.cluster.close.zh} data-aria-en={M.cluster.close.en}><MIcon name="x" size={12} /></button></header>
          <ul class="drawer__tree mono">
            {M.explorer.files.map((f) => <li style={`padding-left:${(f.length - f.trimStart().length) * 6 + 10}px`}>{f.trim()}</li>)}
          </ul>
        </aside>
        <aside class="drawer" data-model-panel="github" hidden>
          <header class="drawer__head"><span><T {...t(M.cluster.github)} /></span><button type="button" class="ib ib--sm" data-model-close aria-label={M.cluster.close.zh} data-aria-zh={M.cluster.close.zh} data-aria-en={M.cluster.close.en}><MIcon name="x" size={12} /></button></header>
          <ul class="drawer__list">
            {M.github.prs.map((pr, i) => (
              <li>
                <MIcon name="pr" size={13} />
                <span class="drawer__pr"><b class="mono">{pr.n}</b> <T {...t(pr.title)} /></span>
                <em class:list={['drawer__state', { 'drawer__state--ok': i === 0 }]}><T {...t(pr.state)} /></em>
              </li>
            ))}
          </ul>
        </aside>
        <aside class="drawer" data-model-panel="resources" hidden>
          <header class="drawer__head"><span><T {...t(M.cluster.resources)} /></span><button type="button" class="ib ib--sm" data-model-close aria-label={M.cluster.close.zh} data-aria-zh={M.cluster.close.zh} data-aria-en={M.cluster.close.en}><MIcon name="x" size={12} /></button></header>
          <ul class="drawer__list">
            {M.resources.rows.map((r) => (
              <li class="res">
                <span class="res__name">{r.name}</span>
                <span class="res__mem mono">{r.mem}</span>
                <span class="res__bar"><i style={`width:${r.cpu * 2}%`} /></span>
              </li>
            ))}
          </ul>
        </aside>

        <!-- 右上工具簇：竖排，顺序照 apps/web/src/shell/ControlsCluster.tsx -->
        <div class="cluster" data-area="cluster" data-model-cluster>
          <button type="button" class="ib" data-model-drawer="explorer" aria-pressed="false" aria-label={M.cluster.explorer.zh} data-aria-zh={M.cluster.explorer.zh} data-aria-en={M.cluster.explorer.en}><MIcon name="tree" /></button>
          <button type="button" class="ib ib--badge" data-model-bottom aria-pressed="false" aria-label={M.cluster.scm.zh} data-aria-zh={M.cluster.scm.zh} data-aria-en={M.cluster.scm.en}><MIcon name="branch" /><b data-model-scm-badge>2</b></button>
          <button type="button" class="ib" data-model-drawer="github" aria-pressed="false" aria-label={M.cluster.github.zh} data-aria-zh={M.cluster.github.zh} data-aria-en={M.cluster.github.en}><MIcon name="pr" /></button>
          <button type="button" class="ib" data-model-drawer="resources" aria-pressed="false" aria-label={M.cluster.resources.zh} data-aria-zh={M.cluster.resources.zh} data-aria-en={M.cluster.resources.en}><MIcon name="activity" /></button>
          <button type="button" class="ib" aria-label={M.cluster.usage.zh} data-aria-zh={M.cluster.usage.zh} data-aria-en={M.cluster.usage.en}><MIcon name="gauge" /></button>
          <span class="cluster__menu-wrap">
            <button type="button" class="ib" data-model-menu aria-haspopup="menu" aria-expanded="false" aria-label={M.cluster.prefs.zh} data-aria-zh={M.cluster.prefs.zh} data-aria-en={M.cluster.prefs.en}><MIcon name="sliders" /></button>
            <span class="pop menu menu--prefs" role="menu" hidden>
              {M.prefs.map((p, i) => (
                <button type="button" role="menuitemcheckbox" aria-checked={i < 2 ? 'true' : 'false'} class="pop__item pop__check" data-model-check>
                  <span class="pop__tick"><MIcon name="check" size={11} /></span>
                  <T {...t(p)} />
                </button>
              ))}
            </span>
          </span>
        </div>

        <!-- 底部停靠的 Git 工具窗口：源码控制在软件里是底部面板 -->
        <section class="bottom" data-model-panel="scm" hidden>
          <div class="bottom__col">
            <header class="drawer__head"><span><T {...t(M.cluster.scm)} /></span></header>
            <p class="drawer__branch mono"><MIcon name="branch" size={12} />{M.scm.branch}</p>
            <p class="drawer__group"><T {...t(M.scm.changes)} /> <span data-model-scm-count>2</span></p>
            <ul class="drawer__files" data-model-scm-files>
              <li><b class="st st--m">M</b><span class="mono">src/auth/session.ts</span></li>
              <li><b class="st st--a">A</b><span class="mono">tests/session.test.ts</span></li>
            </ul>
          </div>
          <div class="bottom__col">
            <span class="drawer__input"><T {...t(M.scm.message)} /></span>
            <button type="button" class="btn btn--solid btn--wide" data-model-commit>
              <span data-commit-idle><T {...t(M.scm.commit)} /></span>
              <span data-commit-done hidden><MIcon name="check" size={12} /><T {...t(M.scm.committed)} /></span>
            </button>
          </div>
          <div class="bottom__col">
            <header class="drawer__head"><span><T {...t(M.scm.graph)} /></span><button type="button" class="ib ib--sm" data-model-close aria-label={M.cluster.close.zh} data-aria-zh={M.cluster.close.zh} data-aria-en={M.cluster.close.en}><MIcon name="x" size={12} /></button></header>
            <ul class="graph mono">
              {M.scm.commits.map((c) => <li><i />{c}</li>)}
            </ul>
          </div>
        </section>

        <!-- Dock：顺序照 apps/web/src/shell/Dock.tsx——锁 | 新建 撤销 重做 整理 白板工具 评论 | 保存点 缩放 -->
        <div class="dock" data-area="dock">
          <button type="button" class="ib" data-model-lock aria-pressed="false" aria-label={M.dock.lock.zh} data-aria-zh={M.dock.lock.zh} data-aria-en={M.dock.lock.en}><MIcon name="lock" /></button>
          <i class="dock__sep"></i>
          <span class="dock__menu-wrap">
            <button type="button" class="ib ib--add" data-model-menu aria-haspopup="menu" aria-expanded="false" aria-label={M.dock.add.zh} data-aria-zh={M.dock.add.zh} data-aria-en={M.dock.add.en}><MIcon name="plus" /></button>
            <span class="pop menu menu--add" role="menu" hidden>
              {
                M.add.groups.map((g) => (
                  <>
                    <span class="pop__title"><T {...t(g.title)} /></span>
                    {g.items.map((it) => <button type="button" role="menuitem" class="pop__item"><T {...t(it)} /></button>)}
                  </>
                ))
              }
            </span>
          </span>
          <button type="button" class="ib" aria-label={M.dock.undo.zh} data-aria-zh={M.dock.undo.zh} data-aria-en={M.dock.undo.en}><MIcon name="undo" /></button>
          <button type="button" class="ib" aria-label={M.dock.redo.zh} data-aria-zh={M.dock.redo.zh} data-aria-en={M.dock.redo.en}><MIcon name="redo" /></button>
          <button type="button" class="ib" data-model-tidy aria-label={M.dock.tidy.zh} data-aria-zh={M.dock.tidy.zh} data-aria-en={M.dock.tidy.en}><MIcon name="tidy" /></button>
          {
            tools.map((tool, i) => (
              <button type="button" class="ib" data-model-tool aria-pressed={i === 0 ? 'true' : 'false'} aria-label={tool.zh} data-aria-zh={tool.zh} data-aria-en={tool.en}>
                <MIcon name={tool.id} />
              </button>
            ))
          }
          <button type="button" class="ib" data-model-toggle aria-pressed="false" aria-label={M.dock.comment.zh} data-aria-zh={M.dock.comment.zh} data-aria-en={M.dock.comment.en}><MIcon name="comment" /></button>
          <i class="dock__sep"></i>
          <span class="dock__saved" aria-label={M.dock.saved.zh} data-aria-zh={M.dock.saved.zh} data-aria-en={M.dock.saved.en} role="img"></span>
          <button type="button" class="ib" data-model-zoom="-1" aria-label={M.dock.zoomOut.zh} data-aria-zh={M.dock.zoomOut.zh} data-aria-en={M.dock.zoomOut.en}><MIcon name="minus" /></button>
          <button type="button" class="dock__zoom mono" data-model-zoom="0" aria-label={M.dock.fit.zh} data-aria-zh={M.dock.fit.zh} data-aria-en={M.dock.fit.en}><span data-model-zoom-label>100%</span></button>
          <button type="button" class="ib" data-model-zoom="1" aria-label={M.dock.zoomIn.zh} data-aria-zh={M.dock.zoomIn.zh} data-aria-en={M.dock.zoomIn.en}><MIcon name="plus" /></button>
        </div>

        <!-- 小地图 -->
        <div class="minimap" aria-hidden="true">
          <i style="left:6%;top:12%;width:20%;height:20%"></i>
          <i style="left:6%;top:48%;width:24%;height:26%"></i>
          <i style="left:36%;top:8%;width:26%;height:36%"></i>
          <i style="left:36%;top:58%;width:26%;height:30%"></i>
          <i style="left:68%;top:8%;width:28%;height:28%"></i>
          <i style="left:68%;top:50%;width:28%;height:30%"></i>
          <b data-model-viewport></b>
        </div>
      </section>
    </div>

    <!-- 权限请求之后追加到终端的行（中英两份） -->
    <template data-model-line="cmd">pnpm test</template>
    <template data-model-line="passed"><T {...t(M.ask.passed)} /></template>
    <template data-model-line="denied"><T {...t(M.ask.denied)} /></template>

  </div>
</div>

<script>
  import { initModel } from '../../scripts/model/interact';
  document.querySelectorAll<HTMLElement>('[data-model]').forEach((m) => initModel(m));
</script>

<style>
  .model {
    position: relative;
    width: 100%;
    height: calc(760px * var(--model-k, 1));
    color: var(--app-text);
  }
  .model__stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 1200px;
    height: 760px;
    transform-origin: 0 0;
    transform: translate(var(--model-x, 0px), 0) scale(var(--model-k, 1));
    transition: transform 700ms var(--ease-out);
  }
  .win {
    display: grid;
    grid-template-columns: 236px 1fr;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--app-canvas);
    border: 1px solid var(--app-border-strong);
    border-radius: var(--app-radius-win);
    box-shadow: var(--app-shadow-win); /* design-ok 软件窗口的系统阴影 */
    font: 400 13px / 1.4 var(--font-sans);
  }


  /* 通用小部件 */
  .ib {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--app-radius-sm);
    color: var(--app-muted);
    transition: background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .ib:hover { background: var(--app-hover); color: var(--app-text); }
  .ib[aria-pressed='true'] { background: var(--app-hover); color: var(--app-brand-text); }
  .ib--sm { width: 22px; height: 22px; }
  .ib:focus-visible, .btn:focus-visible, .side__row:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .ib--badge b {
    position: absolute;
    right: 1px;
    top: 1px;
    min-width: 13px;
    height: 13px;
    padding: 0 3px;
    border-radius: var(--app-pill);
    background: var(--app-brand-solid);
    color: var(--app-on-brand);
    font: 600 9px / 13px var(--font-sans);
  }
  .ib--badge b:empty { display: none; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--app-radius-sm);
