---
/**
 * 全站顶栏：56 高吸顶，背景 85% + 模糊。左：标志与名称；中：首页 / 文档 / 云服务 / 更新日志（当前项品牌文字 +
 * 2px 平移指示器）；右：中 / EN、主题、GitHub、下载。≤640 只留标志、中 / EN 与主题，其余进底部 Dock。
 * 导航项来自 lib/nav.ts，与快捷键、Dock 同源。
 */
import type { PageId } from '../../lib/types';
import { NAV, navCurrent, REPO_URL, RELEASES_URL } from '../../lib/nav';
import T from '../common/T.astro';
import ThemeToggle from '../common/ThemeToggle.astro';
import LangToggle from '../common/LangToggle.astro';
import Icon from '../common/Icon.astro';
import { S } from '../../i18n';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const current = navCurrent(page);
---

<header class="topnav">
  <div class="container topnav__inner">
    <a class="topnav__brand" href="/" aria-label="Armadra">
      <img class="topnav__logo" src="/brand/armadra-96.png" width="24" height="24" alt="" />
      <span class="topnav__mark">Armadra</span>
    </a>

    <nav
      class="topnav__nav"
      aria-label={S.nav.aria.zh}
      data-aria-zh={S.nav.aria.zh}
      data-aria-en={S.nav.aria.en}
      data-indicator-root
      data-axis="x"
      data-item=".topnav__link"
    >
      {
        NAV.map((item) => (
          <a
            class="topnav__link"
            href={item.href}
            aria-current={current === item.id ? 'page' : undefined}
            aria-keyshortcuts={item.key}
          >
            <T zh={item.label.zh} en={item.label.en} />
          </a>
        ))
      }
      <span class="topnav__indicator" data-indicator aria-hidden="true"></span>
    </nav>

    <div class="topnav__tools">
      <LangToggle />
      <ThemeToggle />
      <a class="topnav__icon" href={REPO_URL} aria-label={S.nav.github.zh}>
        <Icon name="github" size={16} />
      </a>
      <a class="topnav__download btn-primary" href={RELEASES_URL}>
        <T zh={S.nav.download.zh} en={S.nav.download.en} />
      </a>
    </div>
  </div>
</header>

<script>
  import { initIndicators } from '../../scripts/indicator';
  initIndicators();
</script>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .topnav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
  }

  .topnav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-group);
    justify-self: start;
    color: var(--text);
  }
  .topnav__logo { flex: none; width: 24px; height: 24px; }
  .topnav__mark { font: 500 var(--text-body) / 1 var(--font-ui); }

  .topnav__nav {
    position: relative;
    display: flex;
    align-items: stretch;
    align-self: stretch;
    gap: var(--space-section);
  }
  .topnav__link {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-item);
    font: 500 var(--text-body) / var(--lh-body) var(--font-ui);
    color: var(--muted-foreground);
    transition: color var(--dur-base) var(--ease-in-out);
  }
  .topnav__link[aria-current='page'] { color: var(--brand-text); }
  @media (hover: hover) and (pointer: fine) {
    .topnav__link:hover { color: var(--text); }
    .topnav__link[aria-current='page']:hover { color: var(--brand-text); }
  }
  .topnav__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background: var(--brand);
    opacity: 0;
    transition: transform var(--dur-base) var(--ease-in-out), opacity var(--dur-fast) var(--ease-out);
  }

  .topnav__tools {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-item);
  }
  .topnav__icon {
    display: inline-grid;
    place-items: center;
    width: var(--icon-btn);
    height: var(--icon-btn);
    border-radius: var(--r-control);
    color: var(--muted-foreground);
    transition: color var(--dur-instant) var(--ease-color), background-color var(--dur-fast) var(--ease-color);
  }
  @media (hover: hover) and (pointer: fine) {
    .topnav__icon:hover { color: var(--text); background: var(--hover); }
  }
  .topnav__download { margin-left: var(--space-group); }

  @media (max-width: 640px) {
    .topnav__nav,
    .topnav__icon,
    .topnav__download { display: none; }
    .topnav__inner { grid-template-columns: 1fr auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .topnav__indicator { transition: opacity var(--dur-fast) linear; }
  }
</style>
