---
/**
 * 文档左侧目录：按分组列出全部文档。当前页底 --brand-soft、文字 --brand-text，
 * 左侧 2px 品牌色指示器随悬停与聚焦平移（scripts/indicator.ts），离开后回到当前页。
 */
import type { DocPair } from '../../lib/docs';
import { GROUPS, groupLabel } from '../../lib/docs';
import { S } from '../../i18n';
import T from '../common/T.astro';

interface Props {
  pairs: DocPair[];
  current?: string;
}
const { pairs, current } = Astro.props;
---

<nav
  class="docs-nav"
  aria-label={S.docs.nav.zh}
  data-aria-zh={S.docs.nav.zh}
  data-aria-en={S.docs.nav.en}
  data-indicator-root
  data-axis="y"
  data-item=".docs-nav__link"
>
  {
    GROUPS.map((g) => {
      const items = pairs.filter((p) => p.group === g);
      if (!items.length) return null;
      const label = groupLabel(g);
      return (
        <section class="docs-nav__group">
          <h2 class="docs-nav__title corner"><T zh={label.zh} en={label.en} /></h2>
          <ul class="docs-nav__list" role="list">
            {items.map((p) => (
              <li>
                <a class="docs-nav__link" href={`/docs/${p.slug}/`} aria-current={p.slug === current ? 'page' : undefined}>
                  <T zh={p.zh.data.title} en={p.en.data.title} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
  <span class="docs-nav__indicator" data-indicator aria-hidden="true"></span>
</nav>

<script>
  import { initIndicators } from '../../scripts/indicator';
  initIndicators();
</script>

<style>
  .docs-nav {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
  }
  .docs-nav__title { margin-bottom: var(--space-group); padding-inline: var(--space-inset); }
  .docs-nav__list { margin: 0; padding: 0; }
  .docs-nav__link {
    display: flex;
    align-items: center;
    min-height: var(--nav-row-h);
    padding-inline: var(--space-inset);
    border-radius: var(--r-control);
    font: 400 var(--text-body) / var(--lh-body) var(--font-ui);
    color: var(--muted-foreground);
    transition: color var(--dur-instant) var(--ease-color), background-color var(--dur-fast) var(--ease-color);
  }
  .docs-nav__link[aria-current='page'] {
    background: var(--brand-soft);
    color: var(--brand-text);
    font-weight: 500;
  }
  @media (hover: hover) and (pointer: fine) {
    .docs-nav__link:hover { color: var(--text); background: var(--hover); }
    .docs-nav__link[aria-current='page']:hover { color: var(--brand-text); background: var(--brand-soft); }
  }
  .docs-nav__indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    border-radius: var(--r-pill);
    background: var(--brand);
    opacity: 0;
    transition: transform var(--dur-base) var(--ease-in-out), opacity var(--dur-fast) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-nav__indicator { transition: opacity var(--dur-fast) linear; }
  }
</style>
