---
import { S, fmtBi } from '../../i18n';
import { NAV, REPO_URL, RELEASES_URL, SITE_REPO_URL } from '../../lib/nav';
import { RELEASE } from '../../data/release';
import T from './T.astro';

// 构建时注入：年份与日期（东八区）
const built = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const rights = fmtBi(S.footer.rights, { year: built.slice(0, 4) });
const builtText = fmtBi(S.footer.built, { date: built, version: RELEASE.version });
const links = [
  ...NAV.filter((n) => n.id !== 'home').map((n) => ({ href: n.href, label: n.label })),
  { href: RELEASES_URL, label: S.footer.releases },
  { href: REPO_URL, label: S.nav.github },
  { href: `${REPO_URL}/issues/new/choose`, label: S.footer.issues },
  { href: SITE_REPO_URL, label: S.footer.source },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <hr class="hairline-x site-footer__rule" />
    <div class="site-footer__id">
      <p class="site-footer__rights meta"><T zh={rights.zh} en={rights.en} /></p>
    </div>
    <ul class="site-footer__links" role="list">
      {links.map((l) => <li><a class="link-quiet" href={l.href}><T zh={l.label.zh} en={l.label.en} /></a></li>)}
    </ul>
    <p class="site-footer__built"><T zh={builtText.zh} en={builtText.en} /></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-foot);
    padding-bottom: calc(var(--space-dock) + env(safe-area-inset-bottom));
  }
  /* 独立放置时自带版心；放进 main 或 .container 内时沿用父级宽度 */
  .site-footer__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: start;
    gap: var(--space-section);
  }
  :global(main) .site-footer__inner,
  :global(.container) .site-footer__inner { max-width: none; padding-inline: 0; }
  .site-footer__rule { grid-column: 1 / -1; margin: 0; }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    justify-self: center;
    gap: var(--space-group) var(--space-section);
    max-width: 420px;
    margin: 0;
    padding: 0;
    font: 400 var(--text-body) / var(--lh-body) var(--font-ui);
  }
  .site-footer__rights { white-space: nowrap; }
  .site-footer__built {
    justify-self: end;
    font: 400 var(--text-meta) / var(--lh-meta) var(--font-code);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .site-footer__inner { grid-template-columns: minmax(0, 1fr); }
    .site-footer__links { justify-content: flex-start; justify-self: stretch; max-width: none; }
    .site-footer__rights { white-space: normal; }
    .site-footer__built { justify-self: start; white-space: normal; }
  }
</style>
