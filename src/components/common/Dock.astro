---
/**
 * 底部居中悬浮胶囊导航：首页 / 文档 / 更新日志 / GitHub 四个 40px 圆形图标钮。
 * 当前页钮下方 4px 品牌圆点；悬停邻近放大（scripts/dock.ts，触屏与减少动效关闭）；
 * 每钮有 aria-label 与 Tooltip（带 Kbd 快捷键）；胶囊后方是不拦指针的底部模糊幕。
 */
import type { PageId } from '../../lib/types';
import { NAV, navCurrent, REPO_URL } from '../../lib/nav';
import { S } from '../../i18n';
import Icon from './Icon.astro';
import Kbd from '../ui/Kbd.astro';
import T from './T.astro';

interface Props {
  page: PageId;
}
const { page } = Astro.props;
const current = navCurrent(page);
const pages = NAV.map((n) => ({ ...n, external: false as const, current: current === n.id }));
---

<div class="dock-veil" aria-hidden="true"></div>
<nav class="dock" data-dock aria-label={S.nav.dockAria.zh} data-aria-zh={S.nav.dockAria.zh} data-aria-en={S.nav.dockAria.en}>
  <ul class="dock__list" role="list" data-dock-list>
    {
      pages.map((n) => (
        <li class="dock__cell" data-dock-cell>
          <a
            class="dock__item"
            data-dock-item
            href={n.href}
            aria-current={n.current ? 'page' : undefined}
            aria-keyshortcuts={n.key}
            aria-label={n.label.zh}
            data-aria-zh={n.label.zh}
            data-aria-en={n.label.en}
          >
            <Icon name={n.icon} size={18} />
          </a>
          <span class="dock__tip" aria-hidden="true">
            <T zh={n.label.zh} en={n.label.en} /><Kbd k={n.key} />
          </span>
        </li>
      ))
    }
    <li class="dock__sep hairline-y" aria-hidden="true"></li>
    <li class="dock__cell" data-dock-cell>
      <a
        class="dock__item"
        data-dock-item
        href={REPO_URL}
        aria-label={S.nav.github.zh}
        data-aria-zh={S.nav.github.zh}
        data-aria-en={S.nav.github.en}
      >
        <Icon name="github" size={18} />
      </a>
      <span class="dock__tip" aria-hidden="true">GitHub</span>
    </li>
  </ul>
</nav>

<script>
  import { initDock } from '../../scripts/dock';
  initDock();
</script>

<style>
  .dock-veil {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-veil);
    height: clamp(80px, 10vh, 200px);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(to top, #000 15%, transparent);
    mask-image: linear-gradient(to top, #000 15%, transparent);
    pointer-events: none;
  }

  .dock {
    position: fixed;
    bottom: calc(var(--dock-gap) + env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    z-index: var(--z-dock);
    width: max-content;
    margin-inline: auto;
    height: var(--dock-h);
    padding: var(--space-group);
    background: color-mix(in srgb, var(--panel) 60%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-overlay);
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .dock.is-low { opacity: 0.6; }
  .dock.is-low:hover,
  .dock.is-low:focus-within { opacity: 1; }

  .dock__list {
    display: flex;
    align-items: center;
    gap: var(--space-group);
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dock__cell {
    position: relative;
    width: var(--dock-item);
    height: var(--dock-item);
  }
  .dock__sep { align-self: stretch; margin-block: var(--space-item); }

  .dock__item {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--muted-foreground);
    transform-origin: 50% 100%;
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-instant) var(--ease-color);
  }
  .dock__item[aria-current='page'] { color: var(--brand-text); }
  .dock__item[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(-1 * var(--space-group));
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: var(--r-pill);
    background: var(--brand);
  }
  @media (hover: hover) and (pointer: fine) {
    .dock__item:hover { color: var(--text); }
    .dock__item[aria-current='page']:hover { color: var(--brand-text); }
  }

  /* Tooltip：首次延迟 500ms；同一列表里已有一个打开时，邻近的立即显示、无过渡 */
  .dock__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--space-gap));
    display: inline-flex;
    align-items: center;
    gap: var(--space-group);
    padding: var(--space-item) var(--space-group);
    background: var(--surface-overlay);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-control);
    box-shadow: var(--shadow-overlay);
    font: 500 var(--text-body) / var(--lh-body) var(--font-ui);
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, var(--space-item));
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .dock__list.is-tips .dock__tip { transition-duration: 0s; transition-delay: 0s; }
  @media (hover: hover) and (pointer: fine) {
    .dock__cell:hover .dock__tip { opacity: 1; transform: translate(-50%, 0); transition-delay: var(--tip-delay); }
    .dock__list.is-tips .dock__cell:hover .dock__tip { transition-delay: 0s; }
  }
  .dock__cell:has(:focus-visible) .dock__tip { opacity: 1; transform: translate(-50%, 0); transition-delay: 0s; }
  @media (hover: none) {
    .dock__tip { display: none; }
  }

  /* 出场：延迟 --dur-slow 后上移淡入并去模糊；只在会话内首次进入站点时播放 */
  @keyframes dock-in {
    from { opacity: 0; transform: translateY(80px); filter: blur(2px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes dock-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  :global(:root[data-dock-in='play']) .dock {
    animation: dock-in var(--dur-hero) var(--ease-out) var(--dur-slow) both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-dock-in='play']) .dock {
      animation: dock-fade var(--dur-fast) linear both;
    }
  }
</style>
