---
/**
 * 站内图标：统一 24 网格、1.5 描边、无填充。
 * 除 github 外均为本项目自绘几何形；github 轮廓改写自 Lucide（ISC 许可）。
 */
type Name = 'search' | 'slash' | 'arrow-up-right' | 'arrow-left' | 'arrow-right' | 'sun' | 'moon' | 'github' | 'hash' | 'copy' | 'download' | 'check' | 'play' | 'pause' | 'replay' | 'fit' | 'plus' | 'minus' | 'home' | 'book' | 'list';

interface Props {
  name: Name;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, class: className, label } = Astro.props;

const PATHS: Record<Name, string[]> = {
  search: ['M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13z', 'M15.25 15.25 20 20'],
  slash: ['M15.5 3.5 8.5 20.5'],
  copy: ['M9 9h11v11H9z', 'M15 5V4H4v11h1'],
  download: ['M12 4v11', 'M7 10l5 5 5-5', 'M5 20h14'],
  check: ['M5 12.5l4.5 4.5L19 7.5'],
  play: ['M7 4.5v15l12-7.5z'],
  pause: ['M8 5v14', 'M16 5v14'],
  replay: ['M4.5 12a7.5 7.5 0 1 0 2.2-5.3', 'M4.5 4v4h4'],
  fit: ['M4 9V4h5', 'M15 4h5v5', 'M20 15v5h-5', 'M9 20H4v-5'],
  plus: ['M12 5v14', 'M5 12h14'],
  minus: ['M5 12h14'],
  'arrow-up-right': ['M7 17 17 7', 'M8.5 7H17v8.5'],
  'arrow-left': ['M19.5 12h-15', 'M10.5 6l-6 6 6 6'],
  'arrow-right': ['M4.5 12h15', 'M13.5 6l6 6-6 6'],
  sun: [
    'M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8z',
    'M12 2.5v2', 'M12 19.5v2', 'M2.5 12h2', 'M19.5 12h2',
    'M5.3 5.3l1.4 1.4', 'M17.3 17.3l1.4 1.4', 'M5.3 18.7l1.4-1.4', 'M17.3 6.7l1.4-1.4',
  ],
  moon: ['M19.5 14.6A7.75 7.75 0 0 1 9.4 4.5a7.75 7.75 0 1 0 10.1 10.1z'],
  github: [
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4',
    'M9 18c-4.51 2-5-2-7-2',
  ],
  home: ['M3.5 11 12 4l8.5 7', 'M5.5 9.5V20h13V9.5', 'M10 20v-6h4v6'],
  book: ['M5 4h14v16H5z', 'M9 4v16', 'M12.5 8.5H16'],
  list: ['M9 6.5h11', 'M9 12h11', 'M9 17.5h11', 'M4 6.5h1.5', 'M4 12h1.5', 'M4 17.5h1.5'],
  hash: ['M4.5 9h15', 'M4.5 15h15', 'M10 4l-2 16', 'M16 4l-2 16'],
};

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={1.5 * (24 / size)}
  stroke-linecap={name === 'github' ? 'round' : 'square'}
  stroke-linejoin={name === 'github' ? 'round' : 'miter'}
  focusable="false"
  {...a11y}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

<style>
  .icon { flex: none; }
</style>
