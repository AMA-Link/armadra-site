---
/**
 * 分区：顶部一条两端渐隐的发丝线（首个分区用 bare 去掉），标题 15px 500，
 * 右侧可放计数或「更多」链接。没有标题的分区用 labelledby 指向内部标题的 id。
 */
import type { Bi } from '../../lib/types';
import T from './T.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title?: Bi;
  count?: Bi | string;
  more?: { href: string; label: Bi };
  /** 不画顶部发丝线（页面第一个分区） */
  bare?: boolean;
  /** 无标题时，内部标题元素的 id */
  labelledby?: string;
}

const { id, title, count, more, bare = false, labelledby } = Astro.props;
const hid = title ? `${id}-h` : labelledby;
const hasHead = !!title;
---

<section class:list={['frame', { 'frame--bare': bare }]} id={id} aria-labelledby={hid}>
  {!bare && <hr class="frame__rule hairline-x" />}
  {
    hasHead && (
      <header class="frame__head">
        <h2 id={hid} class="frame__title"><T zh={title!.zh} en={title!.en} /></h2>
        {(more || count != null) && (
          <div class="frame__aside">
            {count != null && (
              <span class="corner">{typeof count === 'string' ? count : <T zh={count.zh} en={count.en} />}</span>
            )}
            {more && (
              <a class="frame__more link-quiet link-arrow" href={more.href}>
                <T zh={more.label.zh} en={more.label.en} />
                <Icon name="arrow-right" size={12} />
              </a>
            )}
          </div>
        )}
      </header>
    )
  }
  <div class="frame__body"><slot /></div>
</section>

<style>
  .frame { padding-block: 0 var(--space-gap); }
  .frame--bare { padding-top: 0; }
  .frame__rule { margin: 0 0 var(--space-gap); }
  .frame__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-group) var(--space-section);
    margin-bottom: var(--space-section);
  }
  .frame__title {
    font: 500 var(--text-section) / var(--lh-section) var(--font-ui);
    color: var(--text);
  }
  .frame__aside {
    display: flex;
    align-items: baseline;
    gap: var(--space-section);
    margin-left: auto;
  }
  .frame__more { font: 500 var(--text-body) / var(--lh-body) var(--font-ui); }
</style>
