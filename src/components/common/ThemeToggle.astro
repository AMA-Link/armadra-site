---
import { S } from '../../i18n';
import Icon from './Icon.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// SSR 默认深色 + 中文；客户端由 theme.ts 按实际主题与语言同步 aria-label
---

<button type="button" class:list={['theme-toggle', className]} data-theme-toggle aria-label={S.theme.toLight.zh}>
  <span class="tt-when-dark"><Icon name="sun" size={16} /></span>
  <span class="tt-when-light"><Icon name="moon" size={16} /></span>
</button>

<style>
  /* 只显示与当前主题对应的图标 */
  :global(html[data-theme='dark']) .theme-toggle .tt-when-light,
  :global(html[data-theme='light']) .theme-toggle .tt-when-dark { display: none; }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--icon-btn);
    height: var(--icon-btn);
    border-radius: var(--r-control);
    color: var(--muted-foreground);
    transition: color var(--dur-instant) var(--ease-color), background-color var(--dur-fast) var(--ease-color),
      scale var(--dur-instant) var(--ease-out);
  }
  .theme-toggle > span { display: grid; place-items: center; }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover { color: var(--text); background: var(--hover); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle:hover:active { scale: var(--press-scale); }
  }
</style>
