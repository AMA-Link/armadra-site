---
import { S } from '../../i18n';
import T from './T.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// 当前中文 → 动作是「切换到英文」；当前英文 → 「切换到中文」。由 applyLang() 按 data-aria-* 同步
---

<button
  type="button"
  class:list={['lang-toggle', className]}
  data-lang-toggle
  aria-label={S.lang.toEn.zh}
  data-aria-zh={S.lang.toEn.zh}
  data-aria-en={S.lang.toZh.en}
>
  <T zh={S.lang.label.zh} en={S.lang.label.en} />
</button>

<style>
  .lang-toggle {
    display: inline-grid;
    place-items: center;
    min-width: var(--icon-btn);
    height: var(--icon-btn);
    padding-inline: var(--space-item);
    border-radius: var(--r-control);
    color: var(--muted-foreground);
    font: 500 var(--text-meta) / 1 var(--font-code);
    transition: color var(--dur-instant) var(--ease-color), background-color var(--dur-fast) var(--ease-color),
      scale var(--dur-instant) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .lang-toggle:hover { color: var(--text); background: var(--hover); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lang-toggle:hover:active { scale: var(--press-scale); }
  }
</style>
