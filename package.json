{
  "name": "armadra-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-headers.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-design.mjs",
    "check:design": "node scripts/check-design.mjs",
    "sync:release": "node scripts/sync-release.mjs",
    "check:links": "node scripts/check-links.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  }
}
