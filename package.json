{
  "name": "armadra-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-headers.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-design.mjs && node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "sync:release": "node scripts/sync-release.mjs",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "check:links": "node scripts/check-links.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.7",
    "@emnapi/runtime": "1.11.3",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "wrangler": "4.158.0"
  }
}
